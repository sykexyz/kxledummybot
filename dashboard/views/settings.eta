<%~ includeFile("partials/header.eta", {
	user: user
}); %>
<%~ includeFile("partials/message.eta"); %>
<%~ includeFile("partials/title.eta", {
	icon: "fas fa-sliders-h",
	title: "Settings"
}); %>

<div class="container py-4">

	<div class="row g-4">
		<!-- Feedback toggle -->
		<div class="col-12 col-md-6">
			<div class="bg-300 rounded-5 p-4">
				<h5><i class="fas fa-bell me-2"></i>Feedback Messages</h5>
				<p class="text-700 mb-3">When enabled, the bot sends status replies (like "downloading...", "processing..."). When off, the bot only sends the final result.</p>
				<div class="d-flex align-items-center justify-content-between">
					<span class="text-700">Enable feedback</span>
					<label class="switch mb-0">
						<div class="form-check form-switch">
							<input class="form-check-input" id="sw-feedback" type="checkbox" <%= feedbackEnable ? 'checked' : '' %>/>
							<span class="slider round"></span>
						</div>
					</label>
				</div>
				<button class="mt-3 btn btn-phoenix-primary" id="btn-feedback">Save</button>
			</div>
		</div>

		<!-- Whitelist -->
		<div class="col-12 col-md-6">
			<div class="bg-300 rounded-5 p-4">
				<h5><i class="fas fa-user-shield me-2"></i>Bot Whitelist</h5>
				<p class="text-700 mb-3">Only you (bot owner) and whitelisted IDs can control the bot. If the list is empty, only your own account works.</p>

				<div class="input-group mb-3">
					<input type="text" class="form-control" id="wl-id" placeholder="Enter Facebook ID">
					<button class="btn btn-phoenix-primary" id="btn-wl-add">Add</button>
				</div>

				<ul class="list-group list-group-flush" id="wl-list">
					<% for (const id of whiteListIds) { %>
					<li class="list-group-item d-flex justify-content-between align-items-center">
						<span><%= id %></span>
						<button class="btn btn-sm btn-danger" onclick="removeWhitelist('<%= id %>')">Remove</button>
					</li>
					<% } %>
					<% if (whiteListIds.length == 0) { %>
					<li class="list-group-item text-700 text-center">No whitelisted IDs. Only the bot owner can control the bot.</li>
					<% } %>
				</ul>
			</div>
		</div>
	</div>

</div>

<script>
  (function() {
    const btnFeedback = $("#btn-feedback");
    btnFeedback.on("click", function(e) {
      e.preventDefault();
      $.ajax({
        url: "/api/settings/feedback",
        type: "POST",
        data: {
          enable: $("#sw-feedback").is(":checked")
        },
        success: function(data) {
          $.createToast({ title: "Saved", type: "success", message: "Feedback setting updated." });
        },
        error: function() {
          $.createToast({ title: "Error", type: "error", message: "Failed to update feedback setting." });
        }
      });
    });

    function loadWhitelist() {
      $.ajax({
        url: "/api/whitelist/list",
        type: "GET",
        success: function(data) {
          const list = $("#wl-list");
          list.empty();
          if (!data.ids || data.ids.length == 0) {
            list.append('<li class="list-group-item text-700 text-center">No whitelisted IDs. Only the bot owner can control the bot.</li>');
            return;
          }
          data.ids.forEach(function(id) {
            list.append($('<li class="list-group-item d-flex justify-content-between align-items-center"></li>')
              .append($('<span></span>').text(id))
              .append($('<button class="btn btn-sm btn-danger"></button>').text("Remove").on("click", function() { removeWhitelist(id); })));
          });
        }
      });
    }

    $("#btn-wl-add").on("click", function(e) {
      e.preventDefault();
      const id = $("#wl-id").val().trim();
      if (!id) return;
      $.ajax({
        url: "/api/whitelist/add",
        type: "POST",
        data: { id: id },
        success: function(data) {
          if (data.status == "success") {
            $("#wl-id").val("");
            loadWhitelist();
            $.createToast({ title: "Added", type: "success", message: "ID added to whitelist." });
          } else {
            $.createToast({ title: "Error", type: "error", message: data.message || "Failed to add." });
          }
        }
      });
    });

    window.removeWhitelist = function(id) {
      $.ajax({
        url: "/api/whitelist/remove",
        type: "POST",
        data: { id: id },
        success: function(data) {
          if (data.status == "success") {
            loadWhitelist();
            $.createToast({ title: "Removed", type: "success", message: "ID removed from whitelist." });
          }
        }
      });
    };

    loadWhitelist();
  })();
</script>

<%~ includeFile("partials/footer.eta") %>
