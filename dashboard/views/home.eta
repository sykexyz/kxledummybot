<%~ includeFile("partials/header.eta", {
	user: user
}) %>
<%~ includeFile("partials/message.eta") %>
<%~ includeFile("partials/title.eta", {
	icon: "fas fa-home",
	title: "Home"
}); %>

<% if (!user) { %>
<section class="py-5 bg-dark">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-12 col-md-8 col-lg-6">
				<div class="card card-phoenix-dark shadow">
					<div class="card-body p-4">
						<h2 class="text-center mb-4">Welcome to KXLE — BOT</h2>
						<p class="text-center text-muted mb-4">Log in to access your personal dashboard</p>

						<form id="loginForm">
							<div class="mb-3">
								<label class="form-label">Email address</label>
								<input type="email" id="username" class="form-control" placeholder="you@example.com" required />
							</div>
							<div class="mb-3">
								<label class="form-label">Password</label>
								<input type="password" id="password" class="form-control" placeholder="••••••••" required />
							</div>
							<div class="g-recaptcha d-flex justify-content-center mb-3" data-sitekey="<%=it.gRecaptcha_siteKey%>"></div>
							<div class="d-grid">
								<button type="button" class="btn btn-phoenix-primary btn-block" id="homeLogin">Log in</button>
							</div>
						</form>

						<p class="text-center mt-3 text-muted">
							No account? <a href="/register">Register here</a>
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
<% } else { %>
<section class="py-5">
	<div class="container text-center">
		<h1>Welcome back, <%= user.name || user.email %>!</h1>
		<p class="text-muted">You are logged in. Go to your dashboard to manage the bot.</p>
		<a href="/dashboard" class="btn btn-phoenix-primary mt-3">Go to Dashboard</a>
	</div>
</section>
<% } %>

<%~ includeFile('partials/footer.eta') %>

<script type="text/javascript">
  (function() {
    const btn = $('#homeLogin');
    if (btn.length > 0) {
      btn.on("click", async function(e) {
        e.preventDefault();
        const username = $("#username").val();
        const password = $("#password").val();
        const gRecaptcha = grecaptcha.getResponse();
        if (!gRecaptcha)
          return $.createToast({
            type: "error",
            title: "Error",
            message: "Please complete the captcha",
            time: 5000
          });
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Logging in';
        btn.disabled = true;

        $.ajax({
          url: "/login",
          type: "POST",
          data: {
            username: username,
            password: password,
            remember: false,
            "g-recaptcha-response": gRecaptcha
          },
          success: function(data) {
            window.location.href = data.redirectLink || "/dashboard";
          },
          error: function(data) {
            data.responseJSON.errors.forEach(function(error) {
              btn.innerHTML = 'Log in';
              btn.disabled = false;
              grecaptcha.reset();
              $.createToast({
                type: "error",
                title: "Error",
                message: error.msg
              });
            });
          }
        });
      });
    }
  })();
</script>
